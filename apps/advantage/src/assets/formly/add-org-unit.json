[
    {
        "key": "orgunit_type",
        "type": "input",
        "className": "hidden",
        "props": {
            "label": "Org Unit Type",
            "required": true,
            "disabled": true
        }
    },
    {
        "key": "name",
        "type": "input",
        "className": "col-12",
        "hideExpression": "model.orgunit_type!=='cluster'",
        "props": {
            "label": "Name",
            "placeholder": "Enter name of the cluster",
            "required": true,
            "min": 3,
            "minLength": 3
        }
    },
    {
        "key": "name",
        "type": "input",
        "className": "col-12",
        "hideExpression": "model.orgunit_type!=='branch'",
        "props": {
            "label": "Name",
            "placeholder": "Enter name of the branch",
            "required": true,
            "min": 3,
            "minLength": 3
        }
    },
    {
        "key": "name",
        "type": "input",
        "className": "col-12",
        "hideExpression": "model.orgunit_type!=='dept'",
        "props": {
            "label": "Name",
            "placeholder": "Enter name of the department",
            "required": true,
            "min": 3,
            "minLength": 3
        }
    },
    {
        "key": "parent",
        "type": "combobox",
        "className": "col-12 mb-1",
        "hideExpression": "model.orgunit_type!=='branch'",
        "props": {
            "label": "Parent Cluster",
            "store": "clusters",
            "responseKey": "results",
            "useStateParamFilters": true,
            "bindLabel": [
                {
                    "key": "name",
                    "newline": true
                },
                {
                    "key": "phone_number",
                    "class": "pe-1",
                    "label": "Phone"
                },
                {
                    "key": "email_address",
                    "label": "Email"
                }
            ],
            "bindValue": "id",
            "required": true
        }
    },
    {
        "key": "parent",
        "type": "combobox",
        "className": "col-12 mb-1",
        "hideExpression": "model.orgunit_type!=='dept'",
        "props": {
            "label": "Parent Branch",
            "store": "branches",
            "responseKey": "results",
            "useStateParamFilters": true,
            "bindLabel": [
                {
                    "key": "name",
                    "newline": true
                },
                {
                    "key": "phone_number",
                    "class": "pe-1",
                    "label": "Phone"
                },
                {
                    "key": "email_address",
                    "label": "Email"
                }
            ],
            "bindValue": "id",
            "required": true
        }
    },
    {
        "key": "description",
        "type": "textarea",
        "className": "col-12",
        "props": {
            "label": "Description"
        }
    },
    {
        "key": "phone_number",
        "type": "phonenumber",
        "className": "col-6",
        "props": {
            "required": true,
            "label": "Phone Number"
        }
    },
    {
        "key": "email_address",
        "type": "input",
        "className": "ps-3 col-6",
        "props": {
            "required": true,
            "type": "email",
            "label": "Email"
        }
    },
    {
        "key": "physical_address",
        "type": "input",
        "className": "col-6",
        "props": {
            "required": true,
            "label": "Physical Address"
        }
    },
    {
        "key": "postal_address",
        "type": "input",
        "className": "ps-3 col-6",
        "props": {
            "required": true,
            "label": "Postal Address"
        }
    }
]
