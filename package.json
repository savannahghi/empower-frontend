{
  "name": "advantage-frontend",
  "version": "1.0.25",
  "license": "MIT",
  "sideEffects": true,
  "scripts": {
    "ng": "ng",
    "start:test": "ng serve advantage --configuration=test",
    "start:prod": "ng serve advantage --configuration=production",
    "build": "node esbuild.config.js",
    "start": "npm run prestart && ng run advantage:serve-ssr",
    "start-client": "npm run prestart && ng serve advantage",
    "build:prod": "npm run build -- --prod --aot",
    "serve:production": "nx run host:deploy",
    "clear:cache": "nx reset",
    "build:all-production": "nx run-many --target=build --all --configuration production",
    "build:host-production": "nx build host --configuration production",
    "prepare:production": "nx g @nx/workspace:run-commands deploy --project=host --command='rm -rf production && mkdir production && cp -r dist/apps/host/* production && cp -r dist/apps/cashier production && cp -r dist/apps/consultation production && serve -p 3000 production'",
    "test": "ng test advantage",
    "test:runner": "ng test advantage --code-coverage --no-watch --browsers=ChromeHeadless --source-map=false",
    "test:ci": "ng test advantage --browsers=Chrome --watch false --progress false --code-coverage",
    "test:local": "ng test advantage --source-map=false --browsers=HeadlessChromium --watch false --progress false --code-coverage",
    "test:coverage": "rimraf coverage && npm run test -- --code-coverage",
    "lint": "ng lint advantage",
    "lint:ui": "ng lint sil-ui",
    "lint:commit": "npx commitlint --config commitlint.config.js --from=HEAD~1",
    "lint:fix": "ng lint advantage --fix",
    "lint:styles": "stylelint ./apps/advantage/src/**/*.scss",
    "lint:ci": "npm run prettier && npm run lint:commit && npm run lint && npm run lint:styles",
    "prettier": "npx prettier apps/advantage/src --check",
    "prettier:fix": "npm run prettier -- --write",
    "prettier:common:fix": "npm run prettier:common -- --write",
    "format": "npm run prettier:fix && npm run lint:ci",
    "pree2e": "webdriver-manager update --standalone false --gecko false",
    "e2e": "ng e2e",
    "predeploy": "firebase use --token $FIREBASE_DEPLOY_KEY $CI_ENVIRONMENT_SLUG",
    "deploy": "firebase deploy --non-interactive --token $FIREBASE_DEPLOY_KEY",
    "docs": "compodoc -p src/tsconfig.app.json -d docs --disableGraph",
    "docs:coverage": "compodoc -p apps/advantage/src/tsconfig.app.json -d docs --coverageTest 86 --coverageTestThresholdFail=true --disableGraph",
    "docs:serve": "compodoc -p apps/advantage/src/tsconfig.app.json -d docs -s -r 9021 --disableGraph",
    "docs:watch": "compodoc -p apps/advantage/src/tsconfig.app.json -d docs -s -w -r 9021 --disableGraph",
    "prepush": "npm run prettier:fix && npm run lint:ci",
    "release": "node --experimental-modules bump-version.js",
    "start-pwa": "ng build --configuration=development advantage && http-server -p 4200 -c-1 dist",
    "prestart": "node apps/advantage/set-env.ts"
  },
